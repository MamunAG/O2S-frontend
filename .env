# The O2S backend (.NET). Local: http://localhost:5299
# NEXT_PUBLIC_API_URL=http://o2s.runasp.net
NEXT_PUBLIC_API_URL=http://localhost:5299


# Firebase web app "o2s-web" (push notifications). Only the names live here: the values are set in the
# Vercel project's environment variables (Settings -> Environment Variables), which a build reads;
# next.config.mjs hands them to the browser. For a local run, fill them in a .env.local (not committed).
# The service account (o2s_fb_private_key, o2s_fb_client_email, ...) belongs to the backend only.
o2s_fb_apiKey=
o2s_fb_authDomain=
o2s_fb_projectId=
o2s_fb_storageBucket=
o2s_fb_messagingSenderId=
o2s_fb_appId=
o2s_fb_measurementId=
o2s_fb_webpushcertificates_keypair=
